rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pods:
    // - Create: Authenticated users
    // - Read: Authenticated users (could be stricter: only members)
    // - Update: Members only (or admins only for certain fields)
    // For now, allowing authenticated read/write to avoid breaking app, 
    // but this should be tightened in production.
    match /pods/{podId} {
      allow read, write: if request.auth != null;
    }
  }
}
